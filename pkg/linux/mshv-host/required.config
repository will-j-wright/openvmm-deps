# Microsoft Hypervisor root partition
CONFIG_HYPERV=y
CONFIG_MSHV_ROOT=y
CONFIG_X86_X2APIC=y

# Azure VM boot devices and console, built in
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_PCI_HYPERV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y
CONFIG_SERIAL_8250_CONSOLE=y

# Signed loadable modules
CONFIG_MODULES=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y

# No debug info, to keep the artifact small
CONFIG_DEBUG_INFO_NONE=y
