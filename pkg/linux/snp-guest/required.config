# SEV-SNP guest support
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_SEV_GUEST=y
CONFIG_X86_X2APIC=y

# Hyper-V enlightenments (OpenVMM --hv)
CONFIG_HYPERV=y
CONFIG_HYPERV_TIMER=y

# Serial console and initrd shell boot, built in
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y

# Petri agent transport
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# No debug info, to keep the artifact small
CONFIG_DEBUG_INFO_NONE=y
